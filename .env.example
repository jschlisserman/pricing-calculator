# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Verified sender on mastrapricing.ai (must match a verified Resend domain)
RESEND_FROM=Mastra Pricing <orders@mastrapricing.ai>

# --- Auth (WorkOS AuthKit) ---
# WorkOS dashboard → API Keys
WORKOS_API_KEY=sk_test_xxxxxxxx
WORKOS_CLIENT_ID=client_xxxxxxxx

# Random string, 32+ chars, signs the session cookie: `openssl rand -base64 48`
SESSION_SECRET=

# Optional: override the origin used for WorkOS redirects (defaults to the request origin)
# APP_BASE_URL=http://localhost:8888

# Internal (full access) email domains. Defaults to mastra.ai.
INTERNAL_DOMAINS=mastra.ai

# Who gets emailed when an agency requests access (comma-separated).
# Approvals happen in the app's Access tab (any internal user).
ACCESS_REQUEST_RECIPIENTS=josh@mastra.ai,jake@mastra.ai

# Optional static agency allowlists, in addition to approvals made in the Access tab.
AGENCY_DOMAINS=
AGENCY_EMAILS=

# Plain `npm run dev` only (no real login): act as this role. internal | agency
# AUTH_DEV_ROLE=internal
